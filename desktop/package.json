{
  "name": "seven-erp-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Seven ERP Desktop local-first com sincronização direta Seven Mesh",
  "author": "Seven TI Tecnologia & Serviços LTDA",
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main.mjs",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:win": "npm run build:renderer && electron-builder --win nsis --x64",
    "build:mac": "npm run build:renderer && electron-builder --mac dmg zip --universal",
    "pack:local": "npm run build:renderer && electron-builder --dir",
    "start": "npm run build:renderer && electron ."
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "br.com.seventitecnologia.erp",
    "productName": "Seven ERP",
    "copyright": "Copyright © 2026 Seven TI Tecnologia & Serviços LTDA",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/**/*.mjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.mjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Seven-ERP-Mesh-Setup-${version}-${arch}.${ext}",
      "signtoolOptions": {
        "publisherName": "Seven TI Tecnologia & Serviços LTDA"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seven ERP",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "build/EULA.txt",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Seven-ERP-Mesh-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Seven ERP ${version}"
    },
    "afterSign": "scripts/notarize.mjs"
  }
}
